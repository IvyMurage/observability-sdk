  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["observability", "authentication-service", "business-metrics"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Authentication Service",
  "uid": "authentication-service-business"
}
